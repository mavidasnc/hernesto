# config.yaml — preferenze di ernesto.
# Copia questo file come `config.yaml` nella cartella di lavoro oppure in
# ~/.config/ernesto/. Vince il primo dei due che viene trovato: non vengono fusi.
# Tutte le chiavi sono opzionali; un file assente o malformato viene ignorato.

model:
  # ID OpenRouter del modello iniziale, fra quelli del registry in ernesto/models.py.
  # L'opzione --model da riga di comando ha comunque la precedenza.
  default: qwen/qwen3.8-27b
  # JSON mode all'avvio. Attenzione: con true gli strumenti vengono disattivati,
  # perche' response_format json_object e tool calling sono incompatibili.
  json_mode: false

compact:
  # Modello usato per i riassunti della compattazione (/compact llm e, se abilitata,
  # quella automatica). Tienilo economico: riassume il payload piu' grande della sessione.
  summary_model: google/gemini-2.5-flash
  # Con true, al primo turno ernesto chiede se usare i riassunti generati dal modello
  # nella compattazione automatica. Con false resta sempre il riassunto deterministico.
  llm_summary: false

safety:
  # Regex aggiuntive che fanno scattare la richiesta di conferma su run_command.
  # Si sommano a quelle di default (rm -rf, sudo, git push, ...).
  deny_patterns:
    - "shutdown"
    - "mkfs"

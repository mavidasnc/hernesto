# Segreti e credenziali
.env
# contiene solo istruzioni, ma per sicurezza resta fuori dal repo
credentials.md

# Output di sessione
logs/
saves/

# Memorie e spazio di lavoro dell'agente: dati suoi, non del progetto.
# Di workspace/ resta in git il solo README, per documentare la struttura.
memories/
rassegne/
workspace/*
!workspace/README.md

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Bundle autonomo prodotto da build_bundle.py: si rigenera, non si versiona
dist/

# Artefatti dei run di benchmark
es[0-9]*/
*.log
x_tmp_report.md
